# =====================  STACY XMD  - put your keys here  =====================

# ---- Identity ----
BOT_NAME=STACY XMD
OWNER_NAME=
PERSONA=Friendly, warm, a little playful, and concise.
# Facts the AI may use (hours, prices, location, shipping, FAQs). One paragraph is fine.
BUSINESS_INFO=

# ---- Instagram (developers.facebook.com > your app > Instagram > API setup with Instagram login) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Any random string you invent; paste the same one into Meta's webhook setup
IG_VERIFY_TOKEN=

# ---- Groq (console.groq.com/keys) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ---- Supabase (Project Settings > API) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Admin API password (any long random string) ----
ADMIN_TOKEN=

# ---- Feature toggles (true/false) ----
AI_DM_REPLIES=true
AI_COMMENT_REPLIES=true
COMMENT_TOPLEVEL_ONLY=true
HIDE_SPAM=true

# ---- Optional tuning ----
# DM every commenter automatically (leave empty to disable)
COMMENT_DM_TEXT=
BLOCKED_WORDS=free followers,buy followers,crypto giveaway,dm me to earn
HANDOFF_KEYWORDS=human,real person,agent,talk to owner
RATE_LIMIT_PER_MIN=8
HISTORY_LIMIT=12
# WELCOME_MESSAGE=Hey! I'm {bot}, {owner}'s automated assistant...
# HANDOFF_MESSAGE=Got it! I've flagged this for {owner}...
